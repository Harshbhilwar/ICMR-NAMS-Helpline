<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= title %></title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/style.css">
</head>


<body class="login-page">

    <div class="login-background">


        <!-- ========================================= -->
        <!-- ICMR-NAMS RIBBON -->
        <!-- ========================================= -->

        <div class="login-ribbon">

            <div class="ribbon-left"></div>

            <div class="ribbon-title">
                ICMR-NAMS
            </div>

            <div class="ribbon-right"></div>

        </div>


        <!-- ========================================= -->
        <!-- REGISTER CARD -->
        <!-- ========================================= -->

        <div class="login-card register-card">


            <!-- ========================================= -->
            <!-- LOGOS -->
            <!-- ========================================= -->

            <div class="login-logos">

                <img
                    src="/images/icmr-logo.png"
                    alt="Indian Council of Medical Research"
                    class="login-icmr-logo"
                >

                <img
                    src="/images/nams-logo.png"
                    alt="National Academy of Medical Sciences"
                    class="login-nams-logo"
                >

            </div>


            <!-- ========================================= -->
            <!-- REGISTER HEADING -->
            <!-- ========================================= -->

            <div class="register-heading">
                REGISTER
            </div>


            <!-- ========================================= -->
            <!-- MESSAGE -->
            <!-- ========================================= -->

            <div
                id="registerMessage"
                class="register-message"
            ></div>


            <!-- ================================================= -->
            <!-- STEP 1 : EMAIL + OTP VERIFICATION -->
            <!-- ================================================= -->

            <div id="otpVerificationSection">


                <!-- EMAIL -->

                <div class="login-form-group">

                    <label for="register-email">
                        EMAIL ID
                    </label>

                    <input
                        type="email"
                        id="register-email"
                        name="email"
                        class="login-input"
                        placeholder="example@gmail.com"
                        required
                    >

                </div>


                <!-- GET OTP -->

                <button
                    type="button"
                    class="login-submit-button"
                    id="getOtpButton"
                >

                    <i class="bi bi-envelope-fill"></i>

                    Get OTP

                </button>


                <!-- OTP SECTION -->

                <div
                    id="otpSection"
                    class="otp-section"
                >


                    <!-- EMAIL OTP -->

                    <div class="login-form-group">

                        <label for="otp">
                            EMAIL OTP
                        </label>

                        <input
                            type="text"
                            id="otp"
                            name="otp"
                            class="login-input"
                            placeholder="Enter 6-digit OTP"
                            maxlength="6"
                        >

                    </div>


                    <!-- VERIFY OTP -->

                    <button
                        type="button"
                        class="login-submit-button"
                        id="verifyOtpButton"
                    >

                        <i class="bi bi-check-circle-fill"></i>

                        Verify Email OTP

                    </button>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- STEP 2 : USER REGISTRATION FORM -->
            <!-- ================================================= -->

            <div
                id="registrationSection"
                class="registration-section"
                style="display: none;"
            >


                <!-- USER REGISTRATION FORM TITLE -->

                <div class="original-register-title">
                    User Registration Form
                </div>


                <!-- ========================================= -->
                <!-- USERNAME -->
                <!-- ========================================= -->

                <div class="original-input-group">

                    <input
                        type="text"
                        id="username"
                        name="username"
                        class="original-register-input"
                        placeholder="Username"
                        readonly
                    >

                    <span class="original-input-icon">

                        <i class="bi bi-person-fill"></i>

                    </span>

                </div>


                <!-- ========================================= -->
                <!-- EMAIL -->
                <!-- ========================================= -->

                <div class="original-input-group">

                    <input
                        type="email"
                        id="registration-email"
                        name="registrationEmail"
                        class="original-register-input"
                        placeholder="Email"
                        readonly
                    >

                    <span class="original-input-icon">

                        <i class="bi bi-envelope-fill"></i>

                    </span>

                </div>


                <!-- ========================================= -->
                <!-- PASSWORD -->
                <!-- ========================================= -->

                <div class="original-input-group">

                    <input
                        type="password"
                        id="password"
                        name="password"
                        class="original-register-input"
                        placeholder="Password"
                        autocomplete="new-password"
                    >

                    <button
                        type="button"
                        class="original-eye-button"
                        onclick="togglePassword(
                            'password',
                            'passwordEye'
                        )"
                    >

                        <i
                            class="bi bi-lock-fill"
                            id="passwordEye"
                        ></i>

                    </button>

                </div>


                <!-- ========================================= -->
                <!-- CONFIRM PASSWORD -->
                <!-- ========================================= -->

                <div class="original-input-group">

                    <input
                        type="password"
                        id="confirm-password"
                        name="confirmPassword"
                        class="original-register-input"
                        placeholder="Confirm password"
                        autocomplete="new-password"
                    >

                    <button
                        type="button"
                        class="original-eye-button"
                        onclick="togglePassword(
                            'confirm-password',
                            'confirmPasswordEye'
                        )"
                    >

                        <i
                            class="bi bi-lock-fill"
                            id="confirmPasswordEye"
                        ></i>

                    </button>

                </div>


                <!-- ========================================= -->
                <!-- PASSWORD NOTE -->
                <!-- ========================================= -->

                <div class="original-password-note">

                    <strong>Note :</strong>

                    Password minimum length should be
                    of 8–12 characters, Should include at
                    least one uppercase letter, special and
                    numeric character.

                </div>


                <!-- ========================================= -->
                <!-- CAPTCHA -->
                <!-- ========================================= -->

                <div class="original-captcha-row">

                    <div class="original-captcha-box">

                        <span id="captchaText"></span>

                    </div>


                    <button
                        type="button"
                        class="original-captcha-refresh"
                        onclick="generateCaptcha()"
                        title="Refresh Captcha"
                    >

                        <i class="bi bi-arrow-clockwise"></i>

                    </button>

                </div>


                <!-- ========================================= -->
                <!-- CAPTCHA INPUT -->
                <!-- ========================================= -->

                <div class="original-input-group">

                    <input
                        type="text"
                        id="captchaInput"
                        class="original-register-input"
                        placeholder="Enter captcha"
                        autocomplete="off"
                    >

                </div>


                <!-- ========================================= -->
                <!-- COMPLETE REGISTRATION -->
                <!-- ========================================= -->

                <button
                    type="button"
                    class="original-register-button"
                    id="registerButton"
                >

                    <i class="bi bi-person-plus-fill"></i>

                    Complete Registration

                </button>

            </div>


            <!-- ========================================= -->
            <!-- LINKS -->
            <!-- ========================================= -->

            <div class="login-links">

                <a
                    href="/"
                    title="Home"
                >

                    <i class="bi bi-house-fill"></i>

                </a>

                <span>|</span>

                <a href="/login">
                    I already have an account
                </a>

            </div>


        </div>

    </div>


    <!-- ================================================= -->
    <!-- JAVASCRIPT -->
    <!-- ================================================= -->

    <script>


        /* ============================================
           MESSAGE FUNCTION
        ============================================ */

        function showRegisterMessage(
            message,
            type = "success"
        ) {

            const messageBox =
                document.getElementById(
                    "registerMessage"
                );

            messageBox.textContent = message;

            messageBox.className =
                "register-message " + type;
        }



        /* ============================================
           GET OTP
        ============================================ */

        const getOtpButton =
            document.getElementById(
                "getOtpButton"
            );


        getOtpButton.addEventListener(
            "click",
            async () => {


                const emailInput =
                    document.getElementById(
                        "register-email"
                    );


                const email =
                    emailInput.value.trim();


                if (!email) {

                    showRegisterMessage(
                        "Please enter your email address.",
                        "error"
                    );

                    return;
                }


                getOtpButton.disabled = true;


                getOtpButton.innerHTML =
                    '<i class="bi bi-hourglass-split"></i> Sending OTP...';


                try {


                    const response =
                        await fetch(
                            "/send-otp",
                            {

                                method: "POST",

                                headers: {
                                    "Content-Type":
                                        "application/json"
                                },

                                body:
                                    JSON.stringify({
                                        email: email
                                    })

                            }
                        );


                    const data =
                        await response.json();


                    if (data.success) {


                        showRegisterMessage(
                            data.message,
                            "success"
                        );


                        /*
                         * Show OTP field
                         */

                        document
                            .getElementById(
                                "otpSection"
                            )
                            .style.display = "block";


                        /*
                         * Prevent changing email
                         */

                        emailInput.readOnly = true;


                        /*
                         * Change button
                         */

                        getOtpButton.innerHTML =
                            '<i class="bi bi-check-circle-fill"></i> OTP Sent';


                    } else {


                        showRegisterMessage(
                            data.message,
                            "error"
                        );


                        getOtpButton.disabled =
                            false;


                        getOtpButton.innerHTML =
                            '<i class="bi bi-envelope-fill"></i> Get OTP';

                    }


                } catch (error) {


                    console.error(error);


                    showRegisterMessage(
                        "Something went wrong. Please try again.",
                        "error"
                    );


                    getOtpButton.disabled =
                        false;


                    getOtpButton.innerHTML =
                        '<i class="bi bi-envelope-fill"></i> Get OTP';

                }

            }
        );



        /* ============================================
           VERIFY OTP
        ============================================ */

        const verifyOtpButton =
            document.getElementById(
                "verifyOtpButton"
            );


        verifyOtpButton.addEventListener(
            "click",
            async () => {


                const email =
                    document
                        .getElementById(
                            "register-email"
                        )
                        .value
                        .trim();


                const otp =
                    document
                        .getElementById(
                            "otp"
                        )
                        .value
                        .trim();


                if (!otp) {

                    showRegisterMessage(
                        "Please enter the OTP.",
                        "error"
                    );

                    return;
                }


                verifyOtpButton.disabled =
                    true;


                verifyOtpButton.innerHTML =
                    '<i class="bi bi-hourglass-split"></i> Verifying...';


                try {


                    const response =
                        await fetch(
                            "/verify-otp",
                            {

                                method: "POST",

                                headers: {
                                    "Content-Type":
                                        "application/json"
                                },

                                body:
                                    JSON.stringify({
                                        email: email,
                                        otp: otp
                                    })

                            }
                        );


                    const data =
                        await response.json();


                    /* =====================================
                       OTP SUCCESS
                    ===================================== */

                    if (data.success) {


                        showRegisterMessage(
                            data.message,
                            "success"
                        );


                        /*
                         * IMPORTANT:
                         * Hide the complete OTP section.
                         *
                         * This hides:
                         * - Email ID
                         * - Get OTP
                         * - Email OTP
                         * - Verify Email OTP
                         */

                        document
                            .getElementById(
                                "otpVerificationSection"
                            )
                            .style.display = "none";


                        /*
                         * Show User Registration Form
                         */

                        document
                            .getElementById(
                                "registrationSection"
                            )
                            .style.display = "block";


                        /*
                         * Get verified email
                         */

                        const verifiedEmail =
                            document
                                .getElementById(
                                    "register-email"
                                )
                                .value
                                .trim();


                        /*
                         * Automatically create username
                         *
                         * Example:
                         * harsh638865@gmail.com
                         *
                         * Username:
                         * harsh638865
                         */

                        const username =
                            verifiedEmail
                                .split("@")[0];


                        /*
                         * Put username into form
                         */

                        document
                            .getElementById(
                                "username"
                            )
                            .value =
                                username;


                        /*
                         * Put email into form
                         */

                        document
                            .getElementById(
                                "registration-email"
                            )
                            .value =
                                verifiedEmail;


                        /*
                         * Generate new CAPTCHA
                         */

                        generateCaptcha();


                    } else {


                        showRegisterMessage(
                            data.message,
                            "error"
                        );


                        verifyOtpButton.disabled =
                            false;


                        verifyOtpButton.innerHTML =
                            '<i class="bi bi-check-circle-fill"></i> Verify Email OTP';

                    }


                } catch (error) {


                    console.error(error);


                    showRegisterMessage(
                        "Something went wrong. Please try again.",
                        "error"
                    );


                    verifyOtpButton.disabled =
                        false;


                    verifyOtpButton.innerHTML =
                        '<i class="bi bi-check-circle-fill"></i> Verify Email OTP';

                }

            }
        );



        /* ============================================
           PASSWORD SHOW / HIDE
        ============================================ */

        function togglePassword(
            inputId,
            iconId
        ) {


            const input =
                document.getElementById(
                    inputId
                );


            const icon =
                document.getElementById(
                    iconId
                );


            if (
                input.type === "password"
            ) {


                input.type = "text";


                icon.classList.remove(
                    "bi-lock-fill"
                );


                icon.classList.add(
                    "bi-eye-fill"
                );


            } else {


                input.type = "password";


                icon.classList.remove(
                    "bi-eye-fill"
                );


                icon.classList.add(
                    "bi-lock-fill"
                );

            }

        }



        /* ============================================
           CAPTCHA
        ============================================ */

        let currentCaptcha = "";


        function generateCaptcha() {


            const characters =
                "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789";


            let captcha = "";


            for (
                let i = 0;
                i < 6;
                i++
            ) {


                captcha +=
                    characters.charAt(
                        Math.floor(
                            Math.random() *
                            characters.length
                        )
                    );

            }


            currentCaptcha =
                captcha;


            document
                .getElementById(
                    "captchaText"
                )
                .textContent =
                    captcha;

        }



        /* ============================================
           INITIAL CAPTCHA
        ============================================ */

        generateCaptcha();



        /* ============================================
           COMPLETE REGISTRATION
        ============================================ */

        const registerButton =
            document.getElementById(
                "registerButton"
            );


        registerButton.addEventListener(
            "click",
            async () => {


                const email =
                    document
                        .getElementById(
                            "registration-email"
                        )
                        .value
                        .trim();


                const username =
                    document
                        .getElementById(
                            "username"
                        )
                        .value
                        .trim();


                const password =
                    document
                        .getElementById(
                            "password"
                        )
                        .value;


                const confirmPassword =
                    document
                        .getElementById(
                            "confirm-password"
                        )
                        .value;


                const captchaInput =
                    document
                        .getElementById(
                            "captchaInput"
                        )
                        .value
                        .trim();



                /* =====================================
                   PASSWORD EMPTY
                ===================================== */

                if (
                    !password ||
                    !confirmPassword
                ) {

                    showRegisterMessage(
                        "Please enter your password.",
                        "error"
                    );

                    return;
                }



                /* =====================================
                   PASSWORD LENGTH
                ===================================== */

                if (
                    password.length < 8 ||
                    password.length > 12
                ) {

                    showRegisterMessage(
                        "Password must be 8–12 characters long.",
                        "error"
                    );

                    return;
                }



                /* =====================================
                   UPPERCASE
                ===================================== */

                if (
                    !/[A-Z]/.test(password)
                ) {

                    showRegisterMessage(
                        "Password must contain at least one uppercase letter.",
                        "error"
                    );

                    return;
                }



                /* =====================================
                   NUMBER
                ===================================== */

                if (
                    !/[0-9]/.test(password)
                ) {

                    showRegisterMessage(
                        "Password must contain at least one number.",
                        "error"
                    );

                    return;
                }



                /* =====================================
                   SPECIAL CHARACTER
                ===================================== */

                if (
                    !/[!@#$%^&*(),.?":{}|<>_\-+=/\\[\];']/.
                        test(password)
                ) {

                    showRegisterMessage(
                        "Password must contain at least one special character.",
                        "error"
                    );

                    return;
                }



                /* =====================================
                   PASSWORD MATCH
                ===================================== */

                if (
                    password !==
                    confirmPassword
                ) {

                    showRegisterMessage(
                        "Passwords do not match.",
                        "error"
                    );

                    return;
                }



                /* =====================================
                   CAPTCHA EMPTY
                ===================================== */

                if (!captchaInput) {

                    showRegisterMessage(
                        "Please enter the captcha.",
                        "error"
                    );

                    return;
                }



                /* =====================================
                   CAPTCHA CHECK
                ===================================== */

                if (
                    captchaInput.toLowerCase() !==
                    currentCaptcha.toLowerCase()
                ) {

                    showRegisterMessage(
                        "Invalid captcha. Please try again.",
                        "error"
                    );


                    generateCaptcha();


                    document
                        .getElementById(
                            "captchaInput"
                        )
                        .value = "";


                    return;
                }



                /* =====================================
                   DISABLE BUTTON
                ===================================== */

                registerButton.disabled =
                    true;


                registerButton.innerHTML =
                    '<i class="bi bi-hourglass-split"></i> Creating Account...';



                try {


                    const response =
                        await fetch(
                            "/register",
                            {

                                method: "POST",

                                headers: {
                                    "Content-Type":
                                        "application/json"
                                },

                                body:
                                    JSON.stringify({

                                        username:
                                            username,

                                        email:
                                            email,

                                        password:
                                            password,

                                        confirmPassword:
                                            confirmPassword

                                    })

                            }
                        );


                    const data =
                        await response.json();



                    /* =====================================
                       REGISTRATION SUCCESS
                    ===================================== */

                    if (data.success) {


                        showRegisterMessage(
                            data.message,
                            "success"
                        );


                        registerButton.innerHTML =
                            '<i class="bi bi-check-circle-fill"></i> Registration Successful';


                        /*
                         * Redirect to Login
                         */

                        setTimeout(
                            () => {

                                window.location.href =
                                    "/login";

                            },
                            1500
                        );


                    } else {


                        showRegisterMessage(
                            data.message,
                            "error"
                        );


                        registerButton.disabled =
                            false;


                        registerButton.innerHTML =
                            '<i class="bi bi-person-plus-fill"></i> Complete Registration';

                    }


                } catch (error) {


                    console.error(error);


                    showRegisterMessage(
                        "Something went wrong. Please try again.",
                        "error"
                    );


                    registerButton.disabled =
                        false;


                    registerButton.innerHTML =
                        '<i class="bi bi-person-plus-fill"></i> Complete Registration';

                }

            }
        );


    </script>

</body>

</html>