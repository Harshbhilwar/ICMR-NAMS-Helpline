<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Personal Details - ICMR-NAMS</title>

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Bootstrap Icons -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
        rel="stylesheet"
    >

    <!-- Dashboard CSS -->
    <link
        rel="stylesheet"
        href="/css/dashboard.css"
    >

</head>

<body>

<div class="dashboard-wrapper">

    <!-- ================================================= -->
    <!-- SIDEBAR -->
    <!-- ================================================= -->

    <aside class="dashboard-sidebar">

        <div class="sidebar-title">
            ICMR-NAMS
        </div>

        <!-- USER INFORMATION -->

        <div class="sidebar-user">

            <div class="user-id">
                User-ID:
                <strong>
                    <%= user ? user._id : "Pending" %>
                </strong>
            </div>

            <div class="username">
                <%= user ? user.username : "Applicant" %>
            </div>

            <div class="email-verified">
                (Email Verified)
            </div>

        </div>

        <div class="sidebar-separator"></div>


        <!-- ================================================= -->
        <!-- APPLICANT PROFILE -->
        <!-- ================================================= -->

        <div class="sidebar-section-title">
            Applicant Profile
        </div>

        <div
            class="sidebar-menu-item active"
            id="applicantProfileToggle"
        >

            <i class="bi bi-person-fill"></i>

            <span>
                Applicant Profile
            </span>

            <i
                class="bi bi-chevron-down menu-arrow"
                id="applicantProfileArrow"
            ></i>

        </div>

        <div
            class="sidebar-submenu-item"
            id="personalDetailsMenu"
        >

            <i class="bi bi-circle"></i>

            <a href="/personal-details">
                Personal Details
            </a>

        </div>


        <!-- ================================================= -->
        <!-- EXPERT HELP -->
        <!-- ================================================= -->

        <div
            class="sidebar-menu-item"
            id="expertHelpToggle"
        >

            <i class="bi bi-person-workspace"></i>

            <span>
                Expert Help
            </span>

            <i
                class="bi bi-chevron-right menu-arrow"
                id="expertHelpArrow"
            ></i>

        </div>

        <div
            class="sidebar-submenu-item submenu-hidden"
            id="viewApplySessionMenu"
        >

            <i class="bi bi-circle"></i>

            <a href="/view-apply-session">
                View/Apply Session
            </a>

        </div>


        <!-- RESOURCE FACULTY -->

        <div class="sidebar-menu-item standalone">

            <i class="bi bi-info-circle-fill"></i>

            <span>
                Resource Faculty
            </span>

        </div>


        <!-- USER GUIDE -->

        <div class="sidebar-menu-item standalone">

            <i class="bi bi-download"></i>

            <span>
                User Guide (PDF)
            </span>

        </div>


        <!-- LOGOUT -->

        <a
            href="/logout"
            class="dashboard-logout"
        >

            <span>
                Logout
            </span>

            <i class="bi bi-box-arrow-right"></i>

        </a>

    </aside>



    <!-- ================================================= -->
    <!-- MAIN CONTENT -->
    <!-- ================================================= -->

    <main class="dashboard-main">

        <!-- TOP BAR -->

        <div class="dashboard-topbar">

            <button
                type="button"
                class="sidebar-toggle"
                id="sidebarToggle"
            >

                <i class="bi bi-list"></i>

            </button>

            <span class="dashboard-page-title">
                Dashboard
            </span>

        </div>



        <!-- ================================================= -->
        <!-- PERSONAL DETAILS FORM -->
        <!-- ================================================= -->

        <section class="add-personal-details-content">

            <!-- PAGE TITLE -->

            <div class="personal-form-title">
                Personal details of Applicant
            </div>



            <!-- ================================================= -->
            <!-- FORM -->
            <!-- ================================================= -->

            <form
                action="/personal-details/save"
                method="POST"
                class="personal-form-card"
            >


                <!-- ================================================= -->
                <!-- BASIC INFORMATION -->
                <!-- ================================================= -->

                <div class="personal-form-section-title">
                    BASIC INFORMATION
                </div>


                <!-- USER NAME -->

                <div class="personal-form-group">

                    <label>
                        User Name <span>*</span>
                    </label>

                    <input
                        type="text"
                        name="username"
                        value="<%= user && user.username ? user.username : (user ? user.email.split('@')[0] : '') %>"
                        readonly
                    >

                </div>


                <!-- EMAIL -->

                <div class="personal-form-group">

                    <label>
                        Email Address <span>*</span>
                    </label>

                    <input
                        type="email"
                        name="email"
                        value="<%= user ? user.email : '' %>"
                        readonly
                    >

                </div>


                <!-- GENDER -->

                <div class="personal-form-group">

                    <label>
                        Gender <span>*</span>
                    </label>

                    <select
                        name="gender"
                        required
                    >

                        <option value="">
                            Select Gender
                        </option>

                        <option value="Male">
                            Male
                        </option>

                        <option value="Female">
                            Female
                        </option>

                        <option value="Other">
                            Other
                        </option>

                    </select>

                </div>


                <!-- CATEGORY -->

                <div class="personal-form-group">

                    <label>
                        Category <span>*</span>
                    </label>

                    <select
                        name="category"
                        required
                    >

                        <option value="">
                            Select Category
                        </option>

                        <option value="General">
                            General
                        </option>

                        <option value="OBC">
                            OBC
                        </option>

                        <option value="SC">
                            SC
                        </option>

                        <option value="ST">
                            ST
                        </option>

                        <option value="Other">
                            Other
                        </option>

                    </select>

                </div>



                <!-- ================================================= -->
                <!-- WORKING INSTITUTE INFORMATION -->
                <!-- ================================================= -->

                <div class="personal-form-section-title">

                    WORKING INSTITUTE'S INFORMATION

                    <span class="section-note">
                        Note: Institute information is the information from where you will apply proposal
                    </span>

                </div>


                <!-- STATE -->

                <div class="personal-form-group">

                    <label>
                        Select state in which your Institute situated
                        <span>*</span>
                    </label>

                    <select
                        name="state"
                        id="state"
                        required
                    >

                        <option value="">
                            Select State
                        </option>

                        <option value="Andhra Pradesh">
                            Andhra Pradesh
                        </option>

                        <option value="Bihar">
                            Bihar
                        </option>

                        <option value="Delhi">
                            Delhi
                        </option>

                        <option value="Gujarat">
                            Gujarat
                        </option>

                        <option value="Haryana">
                            Haryana
                        </option>

                        <option value="Karnataka">
                            Karnataka
                        </option>

                        <option value="Madhya Pradesh">
                            Madhya Pradesh
                        </option>

                        <option value="Maharashtra">
                            Maharashtra
                        </option>

                        <option value="Rajasthan">
                            Rajasthan
                        </option>

                        <option value="Tamil Nadu">
                            Tamil Nadu
                        </option>

                        <option value="Telangana">
                            Telangana
                        </option>

                        <option value="Uttar Pradesh">
                            Uttar Pradesh
                        </option>

                        <option value="West Bengal">
                            West Bengal
                        </option>

                    </select>

                </div>


                <!-- DISTRICT -->

                <div class="personal-form-group">

                    <label>
                        Select district in which your Institute situated
                        <span>*</span>
                    </label>

                    <select
                        name="district"
                        id="district"
                        required
                    >

                        <option value="">
                            Select District
                        </option>

                    </select>

                </div>


                <!-- INSTITUTE -->

                <div class="personal-form-group">

                    <label>
                        Institute <span>*</span>
                    </label>

                    <select
                        name="institute"
                        id="institute"
                        required
                    >

                        <option value="">
                            Select Institute
                        </option>

                    </select>

                </div>


                <!-- PROGRAMME -->

                <div class="personal-form-group">

                    <label>
                        Name of programme <span>*</span>
                    </label>

                    <select
                        name="programme"
                        required
                    >

                        <option value="">
                            Select
                        </option>

                        <option value="Research">
                            Research
                        </option>

                        <option value="Post Graduation">
                            Post Graduation
                        </option>

                        <option value="PhD">
                            PhD
                        </option>

                        <option value="Other">
                            Other
                        </option>

                    </select>

                </div>


                <!-- DEPARTMENT -->

                <div class="personal-form-group">

                    <label>
                        Your Department <span>*</span>
                    </label>

                    <input
                        type="text"
                        name="department"
                        placeholder="Department name in the Institute"
                        required
                    >

                </div>


                <!-- ================================================= -->
                <!-- BUTTONS -->
                <!-- ================================================= -->

                <div class="personal-form-buttons">

                    <!-- VIEW DETAIL -->

                    <button
                        type="button"
                        class="personal-blue-button"
                        id="viewDetailButton"
                    >

                        <i class="bi bi-eye-fill"></i>

                        View Detail

                    </button>


                    <!-- SAVE DETAIL -->

                    <button
                        type="submit"
                        class="personal-blue-button"
                        id="saveDetailButton"
                    >

                        <i class="bi bi-plus-circle"></i>

                        Save Detail

                    </button>

                </div>


            </form>

        </section>



        <!-- ================================================= -->
        <!-- FOOTER -->
        <!-- ================================================= -->

        <footer class="dashboard-footer">

            <div>

                Copyright © 2026

                <strong>
                    Indian Council of Medical Research, IT Division.
                </strong>

                All rights reserved.

            </div>

            <div id="dashboardDateTime"></div>

        </footer>

    </main>

</div>



<!-- ================================================= -->
<!-- JAVASCRIPT -->
<!-- ================================================= -->

<script>

    /* =================================================
       SIDEBAR COLLAPSE
    ================================================= */

    const sidebarToggle =
        document.getElementById("sidebarToggle");

    const dashboardWrapper =
        document.querySelector(".dashboard-wrapper");

    if (sidebarToggle && dashboardWrapper) {

        sidebarToggle.addEventListener("click", function () {

            dashboardWrapper.classList.toggle(
                "sidebar-collapsed"
            );

        });

    }



    /* =================================================
       APPLICANT PROFILE TOGGLE
    ================================================= */

    const applicantProfileToggle =
        document.getElementById(
            "applicantProfileToggle"
        );

    const personalDetailsMenu =
        document.getElementById(
            "personalDetailsMenu"
        );

    const applicantProfileArrow =
        document.getElementById(
            "applicantProfileArrow"
        );


    if (
        applicantProfileToggle &&
        personalDetailsMenu &&
        applicantProfileArrow
    ) {

        applicantProfileToggle.addEventListener(
            "click",
            function () {

                personalDetailsMenu.classList.toggle(
                    "submenu-hidden"
                );


                if (
                    personalDetailsMenu.classList.contains(
                        "submenu-hidden"
                    )
                ) {

                    applicantProfileArrow.classList.remove(
                        "bi-chevron-down"
                    );

                    applicantProfileArrow.classList.add(
                        "bi-chevron-right"
                    );

                } else {

                    applicantProfileArrow.classList.remove(
                        "bi-chevron-right"
                    );

                    applicantProfileArrow.classList.add(
                        "bi-chevron-down"
                    );

                }

            }
        );

    }



    /* =================================================
       EXPERT HELP TOGGLE
    ================================================= */

    const expertHelpToggle =
        document.getElementById(
            "expertHelpToggle"
        );

    const viewApplySessionMenu =
        document.getElementById(
            "viewApplySessionMenu"
        );

    const expertHelpArrow =
        document.getElementById(
            "expertHelpArrow"
        );


    if (
        expertHelpToggle &&
        viewApplySessionMenu &&
        expertHelpArrow
    ) {

        expertHelpToggle.addEventListener(
            "click",
            function () {

                viewApplySessionMenu.classList.toggle(
                    "submenu-hidden"
                );


                if (
                    viewApplySessionMenu.classList.contains(
                        "submenu-hidden"
                    )
                ) {

                    expertHelpArrow.classList.remove(
                        "bi-chevron-down"
                    );

                    expertHelpArrow.classList.add(
                        "bi-chevron-right"
                    );

                } else {

                    expertHelpArrow.classList.remove(
                        "bi-chevron-right"
                    );

                    expertHelpArrow.classList.add(
                        "bi-chevron-down"
                    );

                }

            }
        );

    }



    /* =================================================
       DATE + TIME
    ================================================= */

    function updateDateTime() {

        const now = new Date();

        const options = {
            weekday: "long",
            year: "numeric",
            month: "long",
            day: "numeric"
        };

        const date =
            now.toLocaleDateString(
                "en-IN",
                options
            );

        const time =
            now.toLocaleTimeString(
                "en-IN",
                {
                    hour: "2-digit",
                    minute: "2-digit",
                    second: "2-digit"
                }
            );

        const dateTimeElement =
            document.getElementById(
                "dashboardDateTime"
            );

        if (dateTimeElement) {

            dateTimeElement.textContent =
                `${date}, ${time}`;

        }

    }

    updateDateTime();

    setInterval(
        updateDateTime,
        1000
    );



