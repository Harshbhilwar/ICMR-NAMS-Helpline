<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Applicant Information - ICMR-NAMS</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="/css/dashboard.css"
    >

    <style>

        .personal-view-content {

            position: absolute;

            top: 51px;
            left: 0;
            right: 0;
            bottom: 50px;

            background: #f1f3f6;

            overflow-y: auto;

            padding: 0 15px 25px 15px;

        }


        .personal-view-heading {

            width: 100%;

            height: 45px;

            background: #9a683f;

            color: #ffffff;

            display: flex;

            align-items: center;

            justify-content: center;

            font-size: 14px;

            font-weight: 700;

            text-decoration: underline;

            margin-bottom: 30px;

        }


        .personal-view-card {

            width: 100%;

            background: #ffffff;

            border: 1px solid #d8dde2;

        }


        .personal-view-section-title {

            width: 100%;

            background: #a0a0a0;

            color: #000000;

            padding: 11px 14px;

            font-size: 13px;

            font-weight: 700;

            text-decoration: underline;

        }


        .personal-view-row {

            display: grid;

            grid-template-columns: 35% 65%;

            min-height: 42px;

            border-bottom: 1px solid #d5d9dd;

            font-size: 13px;

        }


        .personal-view-row:nth-child(even) {

            background: #e7e9ec;

        }


        .personal-view-label {

            padding: 12px 14px;

            font-weight: 600;

            color: #111111;

        }


        .personal-view-value {

            padding: 12px 14px;

            color: #111111;

        }


        .personal-edit-area {

            width: 100%;

            min-height: 62px;

            display: flex;

            justify-content: center;

            align-items: center;

            background: #e7e9ec;

        }


        .edit-personal-button {

            background: #343a40;

            color: #ffffff;

            border: none;

            border-radius: 3px;

            padding: 6px 10px;

            font-size: 13px;

            text-decoration: none;

            font-weight: 600;

        }


        .edit-personal-button:hover {

            background: #212529;

            color: #ffffff;

        }

    </style>

</head>


<body>

<div class="dashboard-wrapper">


    <!-- ================================================= -->
    <!-- SIDEBAR -->
    <!-- ================================================= -->

    <aside class="dashboard-sidebar">

        <div class="sidebar-title">
            ICMR-NAMS
        </div>


        <div class="sidebar-user">

            <div class="user-id">

                User-ID:

                <strong>
                    <%= user ? user._id : "Pending" %>
                </strong>

            </div>


            <div class="username">

                <%= user ? user.username : "Applicant" %>

            </div>


            <div class="email-verified">
                (Email Verified)
            </div>

        </div>


        <div class="sidebar-separator"></div>


        <div class="sidebar-section-title">
            Applicant Profile
        </div>


        <div
            class="sidebar-menu-item active"
            id="applicantProfileToggle"
        >

            <i class="bi bi-person-fill"></i>

            <span>
                Applicant Profile
            </span>

            <i
                class="bi bi-chevron-down menu-arrow"
                id="applicantProfileArrow"
            ></i>

        </div>


        <div
            class="sidebar-submenu-item"
            id="personalDetailsMenu"
        >

            <i class="bi bi-circle"></i>

            <a href="/personal-details">
                Personal Details
            </a>

        </div>


        <div
            class="sidebar-menu-item"
            id="expertHelpToggle"
        >

            <i class="bi bi-person-workspace"></i>

            <span>
                Expert Help
            </span>

            <i
                class="bi bi-chevron-right menu-arrow"
                id="expertHelpArrow"
            ></i>

        </div>


        <div
            class="sidebar-submenu-item submenu-hidden"
            id="viewApplySessionMenu"
        >

            <i class="bi bi-circle"></i>

            <a href="/view-apply-session">
                View/Apply Session
            </a>

        </div>


        <div class="sidebar-menu-item standalone">

            <i class="bi bi-info-circle-fill"></i>

            <span>
                Resource Faculty
            </span>

        </div>


        <div class="sidebar-menu-item standalone">

            <i class="bi bi-download"></i>

            <span>
                User Guide (PDF)
            </span>

        </div>


        <a
            href="/logout"
            class="dashboard-logout"
        >

            <span>
                Logout
            </span>

            <i class="bi bi-box-arrow-right"></i>

        </a>

    </aside>


    <!-- ================================================= -->
    <!-- MAIN -->
    <!-- ================================================= -->

    <main class="dashboard-main">


        <!-- TOP BAR -->

        <div class="dashboard-topbar">

            <button
                type="button"
                class="sidebar-toggle"
                id="sidebarToggle"
            >

                <i class="bi bi-list"></i>

            </button>


            <span class="dashboard-page-title">
                Dashboard
            </span>

        </div>


        <!-- ================================================= -->
        <!-- PERSONAL INFORMATION -->
        <!-- ================================================= -->

        <section class="personal-view-content">


            <div class="personal-view-heading">

                APPLICANT INFORMATION

            </div>


            <div class="personal-view-card">


                <!-- BASIC INFORMATION -->

                <div class="personal-view-section-title">

                    PERSONAL/BASIC INFORMATION

                </div>


                <div class="personal-view-row">

                    <div class="personal-view-label">
                        User Name
                    </div>

                    <div class="personal-view-value">
                        <%= user.username %>
                    </div>

                </div>


                <div class="personal-view-row">

                    <div class="personal-view-label">
                        Email address
                    </div>

                    <div class="personal-view-value">
                        <%= user.email %>
                    </div>

                </div>


                <div class="personal-view-row">

                    <div class="personal-view-label">
                        Gender
                    </div>

                    <div class="personal-view-value">
                        <%= user.gender || "-" %>
                    </div>

                </div>


                <div class="personal-view-row">

                    <div class="personal-view-label">
                        Category
                    </div>

                    <div class="personal-view-value">
                        <%= user.category || "-" %>
                    </div>

                </div>


                <!-- INSTITUTE INFORMATION -->

                <div class="personal-view-section-title">

                    INSTITUTE INFORMATION

                </div>


                <div class="personal-view-row">

                    <div class="personal-view-label">
                        Institute's Location (District, State)
                    </div>

                    <div class="personal-view-value">

                        <%= user.district
                            ? user.district.toUpperCase()
                            : "-" %>,

                        <%= user.state
                            ? user.state.toUpperCase()
                            : "-" %>

                    </div>

                </div>


                <div class="personal-view-row">

                    <div class="personal-view-label">
                        Institute Name
                    </div>

                    <div class="personal-view-value">
                        <%= user.institute || "-" %>
                    </div>

                </div>


                <div class="personal-view-row">

                    <div class="personal-view-label">
                        Name of programme
                    </div>

                    <div class="personal-view-value">
                        <%= user.programme || "-" %>
                    </div>

                </div>


                <div class="personal-view-row">

                    <div class="personal-view-label">
                        Department:
                    </div>

                    <div class="personal-view-value">
                        <%= user.department || "-" %>
                    </div>

                </div>


                <!-- EDIT BUTTON -->

                <div class="personal-edit-area">

                    <a
                        href="/personal-details/add"
                        class="edit-personal-button"
                    >

                        <i class="bi bi-pencil-square"></i>

                        Edit Personal Detail

                    </a>

                </div>


            </div>

        </section>


        <!-- ================================================= -->
        <!-- FOOTER -->
        <!-- ================================================= -->

        <footer class="dashboard-footer">

            <div>

                Copyright © 2026

                <strong>
                    Indian Council of Medical Research, IT Division.
                </strong>

                All rights reserved.

            </div>


            <div id="dashboardDateTime"></div>

        </footer>


    </main>

</div>


<script>

    /* SIDEBAR */

    const sidebarToggle =
        document.getElementById(
            "sidebarToggle"
        );

    const dashboardWrapper =
        document.querySelector(
            ".dashboard-wrapper"
        );


    sidebarToggle.addEventListener(
        "click",
        function () {

            dashboardWrapper.classList.toggle(
                "sidebar-collapsed"
            );

        }
    );


    /* APPLICANT PROFILE */

    const applicantProfileToggle =
        document.getElementById(
            "applicantProfileToggle"
        );

    const personalDetailsMenu =
        document.getElementById(
            "personalDetailsMenu"
        );

    const applicantProfileArrow =
        document.getElementById(
            "applicantProfileArrow"
        );


    applicantProfileToggle.addEventListener(
        "click",
        function () {

            personalDetailsMenu.classList.toggle(
                "submenu-hidden"
            );


            if (
                personalDetailsMenu.classList.contains(
                    "submenu-hidden"
                )
            ) {

                applicantProfileArrow.classList.remove(
                    "bi-chevron-down"
                );

                applicantProfileArrow.classList.add(
                    "bi-chevron-right"
                );

            } else {

                applicantProfileArrow.classList.remove(
                    "bi-chevron-right"
                );

                applicantProfileArrow.classList.add(
                    "bi-chevron-down"
                );

            }

        }
    );


    /* EXPERT HELP */

    const expertHelpToggle =
        document.getElementById(
            "expertHelpToggle"
        );

    const viewApplySessionMenu =
        document.getElementById(
            "viewApplySessionMenu"
        );

    const expertHelpArrow =
        document.getElementById(
            "expertHelpArrow"
        );


    expertHelpToggle.addEventListener(
        "click",
        function () {

            viewApplySessionMenu.classList.toggle(
                "submenu-hidden"
            );


            if (
                viewApplySessionMenu.classList.contains(
                    "submenu-hidden"
                )
            ) {

                expertHelpArrow.classList.remove(
                    "bi-chevron-down"
                );

                expertHelpArrow.classList.add(
                    "bi-chevron-right"
                );

            } else {

                expertHelpArrow.classList.remove(
                    "bi-chevron-right"
                );

                expertHelpArrow.classList.add(
                    "bi-chevron-down"
                );

            }

        }
    );


    /* DATE + TIME */

    function updateDateTime() {

        const now = new Date();

        const options = {

            weekday: "long",

            year: "numeric",

            month: "long",

            day: "numeric"

        };


        const date =
            now.toLocaleDateString(
                "en-IN",
                options
            );


        const time =
            now.toLocaleTimeString(
                "en-IN",
                {
                    hour: "2-digit",
                    minute: "2-digit",
                    second: "2-digit"
                }
            );


        document.getElementById(
            "dashboardDateTime"
        ).textContent =
            `${date}, ${time}`;

    }


    updateDateTime();


    setInterval(
        updateDateTime,
        1000
    );

</script>


</body>

</html>