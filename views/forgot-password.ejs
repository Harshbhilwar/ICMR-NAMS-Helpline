<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= title %></title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="login-page">

    <div class="login-background">

        <!-- ICMR-NAMS RIBBON -->
        <div class="login-ribbon">

            <div class="ribbon-left"></div>

            <div class="ribbon-title">
                ICMR-NAMS
            </div>

            <div class="ribbon-right"></div>

        </div>


        <!-- FORGOT PASSWORD CARD -->
        <div class="login-card forgot-password-card">

            <!-- LOGOS -->
            <div class="login-logos">

                <img
                    src="/images/icmr-logo.png"
                    alt="Indian Council of Medical Research"
                    class="login-icmr-logo"
                >

                <img
                    src="/images/nams-logo.png"
                    alt="National Academy of Medical Sciences"
                    class="login-nams-logo"
                >

            </div>


            <div class="register-heading">
                FORGOT PASSWORD
            </div>


            <!-- EMAIL -->
            <div class="login-form-group">

                <label for="forgot-email">
                    REGISTERED EMAIL ID
                </label>

                <input
                    type="email"
                    id="forgot-email"
                    name="email"
                    class="login-input"
                    placeholder="example@gmail.com"
                    required
                >

            </div>


            <!-- GET OTP -->
            <button
                type="button"
                class="login-submit-button"
                id="forgotGetOtpButton"
            >
                <i class="bi bi-envelope-fill"></i>
                Get OTP
            </button>


            <!-- OTP SECTION -->
            <div
                id="forgotOtpSection"
                class="otp-section"
            >

                <div class="login-form-group">

                    <label for="forgot-otp">
                        EMAIL OTP
                    </label>

                    <input
                        type="text"
                        id="forgot-otp"
                        name="otp"
                        class="login-input"
                        placeholder="Enter 6-digit OTP"
                        maxlength="6"
                    >

                </div>


                <button
                    type="button"
                    class="login-submit-button"
                    id="forgotVerifyOtpButton"
                >
                    <i class="bi bi-check-circle-fill"></i>
                    Verify OTP
                </button>

            </div>


            <!-- NEW PASSWORD -->
            <div
                id="newPasswordSection"
                class="registration-section"
            >

                <div class="login-form-group">

                    <label for="new-password">
                        NEW PASSWORD
                    </label>

                    <input
                        type="password"
                        id="new-password"
                        name="newPassword"
                        class="login-input"
                        placeholder="******"
                    >

                </div>


                <div class="login-form-group">

                    <label for="confirm-new-password">
                        CONFIRM NEW PASSWORD
                    </label>

                    <input
                        type="password"
                        id="confirm-new-password"
                        name="confirmNewPassword"
                        class="login-input"
                        placeholder="******"
                    >

                </div>


                <button
                    type="button"
                    class="login-submit-button"
                    id="resetPasswordButton"
                >
                    <i class="bi bi-key-fill"></i>
                    Reset Password
                </button>

            </div>


            <!-- LINKS -->
            <div class="login-links">

                <a href="/" title="Home">
                    <i class="bi bi-house-fill"></i>
                </a>

                <span>|</span>

                <a href="/login">
                    Login
                </a>

                <span>|</span>

                <a href="/register">
                    Register
                </a>

            </div>

        </div>

    </div>

</body>
</html>